# Saarthi, the assistant. Add ONE of these and answers switch on.
# Nothing else in the site needs a key.
#
# If more than one is present, the first one found in this order wins:
# Grok, Claude, OpenAI, Gemini. Use SAARTHI_PROVIDER to override that.

# Grok (xAI)
# XAI_API_KEY=xai-...

# Claude
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Gemini
# GEMINI_API_KEY=...

# Optional: force a provider or pin a model
# SAARTHI_PROVIDER=xai
# SAARTHI_MODEL=grok-4.6

# Contact form delivery. Without these the form still works: it opens the
# visitor's own mail app with the message written out. With them, Send
# delivers straight to the inbox below, attachments included.
# RESEND_API_KEY=re_...
# CONTACT_TO=shivamraj.connectme@gmail.com
# CONTACT_FROM=JEE Ultimate 2.0 <onboarding@resend.dev>
